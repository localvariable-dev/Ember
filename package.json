{
  "name": "ember",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --clean",
    "build:apk": "npm run prebuild && cd android && ./gradlew assembleRelease",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "jest --forceExit",
    "test:tz": "TZ=Asia/Kolkata jest --forceExit && TZ=America/New_York jest --forceExit",
    "verify:assets": "node tools/audio/verify-assets.mjs",
    "manifest": "node tools/audio/generate-manifest.mjs",
    "placeholders": "node tools/audio/make-placeholders.mjs && node tools/audio/make-chime.mjs && node tools/audio/generate-manifest.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.2.3",
    "@expo-google-fonts/inter": "^0.2.3",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "better-sqlite3": "^13.0.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.4.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react"
      ]
    }
  }
}
